# Copy this file to .env and fill in the values. .env is git-ignored.

# Plivo credentials (Plivo Console -> Overview)
PLIVO_AUTH_ID=your_auth_id
PLIVO_AUTH_TOKEN=your_auth_token

# Plivo number the call is made FROM (E.164 format)
PLIVO_FROM_NUMBER=+918035454161

# Live associate number for Level 2, option 2 (E.164 format)
ASSOCIATE_NUMBER=+912264236412

# Number pre-filled in the web UI (optional)
DEFAULT_TO_NUMBER=+91XXXXXXXXXX

# OTP = birthdate in DDMM format
OTP=0106

# MP3 for Level 2 option 1, per language. Leave empty for the defaults:
# English = bundled static/message.mp3, Spanish = Plivo's sample music.mp3
AUDIO_URL_EN=
AUDIO_URL_ES=

# Public URL of this app (from cloudflared / ngrok / your host), no trailing slash
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
